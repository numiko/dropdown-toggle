{
  "name": "@numiko/dropdown-toggle",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest --run --reporter junit --outputFile ./reports/results.xml --coverage.enabled --coverage.include lib --coverage.reporter=html --coverage.reportsDirectory ./reports/",
    "release": "release-it"
  },
  "main": "./dist/DropdownToggle.umd.js",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/DropdownToggle.es.js",
      "require": "./dist/DropdownToggle.umd.js"
    }
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^4.2.0",
    "@vitest/coverage-v8": "^3.0.9",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "happy-dom": "^17.4.4",
    "release-it": "^18.1.2",
    "vite": "^6.2.2",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^3.0.9"
  },
  "peerDependencies": {
    "gsap": "^3.12.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.18.0"
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it/schema/release-it.json",
    "hooks": {
      "before:init": [
        "vitest run"
      ],
      "after:bump": [
        "npm run build"
      ]
    }
  }
}
